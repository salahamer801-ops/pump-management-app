{
  "services": [
    {
      "name": "web",
      "command": "npm run dev",
      "port": 5173,
      "web": true,
      "setup": "npm install --no-audit --no-fund",
      "deploy": {
        "build": "npm run build",
        "static": "dist",
        "runtime": "static"
      }
    },
    {
      "name": "api",
      "command": "node server/src/index.js",
      "port": 3001,
      "web": false,
      "setup": "npm --prefix server install --no-audit --no-fund",
      "deploy": {
        "dockerfile": "Dockerfile",
        "context": ".",
        "memoryMb": 512
      }
    }
  ],
  "database": true
}
